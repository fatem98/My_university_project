
import random

def play_game():

    secret_number = random.randint(1, 100)
    max_attempts = 5
    won = False

    print("\nGuess the Number Game!")
    print("I have selected a number between 1 and 100.")
    print("You have 5 chances to guess the number.\n")

    for attempt in range(1, max_attempts + 1):

        while True:
            try:
                guess = int(input("Enter your guess: "))

                if 1 <= guess <= 100:
                    break
                else:
                    print("Please enter a number between 1 and 100.")

            except ValueError:
                print("Invalid input! Please enter a number.")

        remaining = max_attempts - attempt

        print("\nAttempt", attempt, "of", max_attempts)
        print("Remaining chances:", remaining)

        if guess == secret_number:
            won = True
            print("\nCongratulations! You won!")

            if attempt == 1:
                print("Your rank: Excellent!")
            elif attempt == 2:
                print("Your rank: Very Good!")
            elif attempt == 3:
                print("Your rank: Good!")
            elif attempt == 4:
                print("Your rank: Acceptable!")
            elif attempt == 5:
                print("Your rank: Lucky Winner!")

            break

        difference = abs(guess - secret_number)

        if difference <= 5:
            print("Very close!")

        elif difference <= 15:
            print("You are close, but still a little far!")

        else:
            print("You are too far!")

        if guess < secret_number:
            print("Try a higher number.")

        else:
            print("Try a lower number.")

    if not won:
        print("\nSorry! You ran out of chances.")
        print("You lost!")
        print("The secret number was:", secret_number)


while True:

    play_game()

    answer = input("\nDo you want to play again? (yes/no): ")

    if answer.strip().lower() not in ["yes", "y"]:
        print("\nThank you for playing! Goodbye.")
        break

